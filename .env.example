# Personal access token, only used by `npm run contributors` to read the
# GitHub API. Not needed to run the site.
GH_TOKEN=ghp_XXXXXXXXXXXXXXXXX

NEXT_PUBLIC_DISCORD_WEBHOOK_URL_FEEDBACK=https://discord.com/api/webhooks/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# GitHub OAuth App credentials, used by /api/auth/* so contributors can sign in
# and publish a blog proposal from their own account. Only needed if you are
# working on the blog editor; put them in .env.local (gitignored), never here.
# Create an app at https://github.com/settings/developers with the callback URL
# http://localhost:3000/api/auth/github/callback for local development.
GITHUB_CLIENT_ID=Ov23liXXXXXXXXXXXXXX
GITHUB_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Community layer (accounts, community presets, likes, cloud-saved configs).
# Both are public by design (they ship in the browser bundle; Row Level
# Security in supabase/migrations protects the data). Leave them unset and the
# whole community layer switches itself off. Setup: supabase/README.md.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX
